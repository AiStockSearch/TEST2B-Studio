# Публичные (попадают в браузер): URL проекта и publishable/anon ключ
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Только сервер (Vercel env, не в репозиторий): Session pooler, пароль URL-encoded
DATABASE_URL=
# prisma (по умолчанию, если задан DATABASE_URL) | supabase (PostgREST с JWT пользователя)
DATA_DRIVER=
# Только для scripts/security-check.ts (локально)
CHECK_MANAGER_EMAIL=
CHECK_MANAGER_PASSWORD=
CHECK_WORKER_EMAIL=
CHECK_WORKER_PASSWORD=
