// Модели соответствуют supabase/migrations (источник правды — SQL-миграции).
// Обновление: `npx prisma db pull` по DATABASE_URL. prisma migrate НЕ используется.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum user_role {
  manager
  worker
}

enum attachment_kind {
  brief
  result
}

enum task_status {
  new
  in_progress
  review
  accepted
  rework
}

model profiles {
  id         String      @id @db.Uuid
  role       user_role   @default(worker)
  full_name  String
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  objects    objects[]
  assigned   tasks[]     @relation("tasks_assignee")
  authored   tasks[]     @relation("tasks_author")
  history    task_status_history[]
  attachments task_attachments[]
}

model objects {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  address    String
  created_by String   @default(dbgenerated("auth.uid()")) @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  creator    profiles @relation(fields: [created_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  tasks      tasks[]
}

model tasks {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String      @default("")
  object_id   String      @db.Uuid
  assignee_id String      @db.Uuid
  author_id   String      @default(dbgenerated("auth.uid()")) @db.Uuid
  status      task_status @default(new)
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  updated_at  DateTime    @default(now()) @db.Timestamptz(6)
  object      objects     @relation(fields: [object_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  assignee    profiles    @relation("tasks_assignee", fields: [assignee_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  author      profiles    @relation("tasks_author", fields: [author_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  history     task_status_history[]
  attachments task_attachments[]

  @@index([object_id])
  @@index([assignee_id, status])
  @@index([author_id])
}

model task_status_history {
  id          BigInt       @id @default(autoincrement())
  task_id     String       @db.Uuid
  from_status task_status?
  to_status   task_status
  changed_by  String       @db.Uuid
  comment     String?
  changed_at  DateTime     @default(now()) @db.Timestamptz(6)
  task        tasks        @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  actor       profiles     @relation(fields: [changed_by], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([task_id, changed_at])
}

// Вложения: запись пишется raw INSERT (grant только на task_id, kind, storage_path)
model task_attachments {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id      String          @db.Uuid
  kind         attachment_kind
  storage_path String          @unique
  uploaded_by  String          @default(dbgenerated("auth.uid()")) @db.Uuid
  created_at   DateTime        @default(dbgenerated("now()")) @db.Timestamptz(6)
  task         tasks           @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  uploader     profiles        @relation(fields: [uploaded_by], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([task_id, kind])
}
